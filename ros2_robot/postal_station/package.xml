<?xml version="1.0"?>
<package format="3">
  <name>postal_station</name><version>0.2.0</version>
  <description>PC control station: local web UI, arm planning bridge, RViz diagnostics</description>
  <maintainer email="robot@example.invalid">Robot team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>postal_robot_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>rviz2</exec_depend><exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
