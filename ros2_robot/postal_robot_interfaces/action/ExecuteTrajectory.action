# Executed on the robot. Only one goal at a time; a concurrent goal is rejected.
# Cancel, lease loss, fault, stale feedback or tracking error -> arm held at the
# last fresh measured position (torque unchanged).
trajectory_msgs/JointTrajectory trajectory   # rev_motor_01..07, radians
string plan_id
bool collision_checked                        # must be true
string collision_scene_sha256                 # must be non-empty
# Per-joint bound (rad) of the static-error compensation at the final pose,
# validated collision-free by the planner; empty or 0 = no compensation.
float64[] compensation_limit_rad
# Looser acceptance (rad) for poses next to an obstacle where the servo cannot reach
# the exact target; 0 = robot defaults. Success then also needs the arm to be settled.
# Capped by the robot (max 0.08).
# Ratio of the plan's acceleration limit to the calibrated one; the servo acceleration register
# follows it. 0 = legacy behaviour (speed ratio squared).
float64 acceleration_ratio
float64 arrival_tolerance_rad
float64 start_tolerance_rad      # for a leg that starts from such a pose
---
int8 SUCCEEDED=0
int8 REJECTED=1
int8 ABORTED=2
int8 CANCELED=3
int8 error_code
string message
float64[] final_positions
---
string stage
float64 progress
float64 max_tracking_error_rad
