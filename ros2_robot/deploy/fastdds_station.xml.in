<?xml version="1.0" encoding="UTF-8" ?>
<!-- Generated by station.sh: restrict station DDS traffic to the Wi-Fi interface. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>wifi_udp</transport_id>
      <type>UDPv4</type>
      <maxInitialPeersRange>32</maxInitialPeersRange>
      <interfaceWhiteList>
        <address>@PC_IP@</address>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>local_shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="postal_station" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>wifi_udp</transport_id>
        <transport_id>local_shm</transport_id>
      </userTransports>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>@ROBOT_IP@</address></udpv4></locator>
          <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
